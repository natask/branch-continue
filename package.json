{
  "name": "branch-continue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @natnaelkahssay/card-stack-3d build && vite",
    "build": "pnpm --filter @natnaelkahssay/card-stack-3d build && tsc -b && vite build",
    "deploy": "pnpm app:deploy",
    "app:package": "pnpm tauri:build",
    "app:deploy": "pnpm app:package && ./scripts/deploy-single-app.sh",
    "desktop:updater:init": "node scripts/desktop-updater.mjs init",
    "desktop:ota:stage": "node scripts/desktop-updater.mjs stage",
    "desktop:ota:package": "node scripts/desktop-updater.mjs package",
    "desktop:ota:deploy": "node scripts/desktop-updater.mjs deploy",
    "voice:gcp:setup": "bash scripts/setup-chirp-gcp.sh",
    "mobile:ota:bundle": "node --env-file-if-exists=.env scripts/mobile-ota.mjs bundle",
    "mobile:ota:deploy": "node --env-file-if-exists=.env scripts/mobile-ota.mjs deploy",
    "mobile:shell:android": "node --env-file-if-exists=.env scripts/mobile-ota.mjs shell android",
    "mobile:shell:android:apk": "node --env-file-if-exists=.env scripts/mobile-ota.mjs shell android --apk",
    "mobile:shell:ios": "node --env-file-if-exists=.env scripts/mobile-ota.mjs shell ios",
    "test": "pnpm --filter @natnaelkahssay/card-stack-3d build && vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node --env-file-if-exists=.env scripts/desktop-updater.mjs package",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build"
  },
  "dependencies": {
    "@audio/decode-webm": "^1.2.1",
    "@master-orch/client": "link:../master-orch/packages/master-orch-client",
    "@natnaelkahssay/card-stack-3d": "workspace:*",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-updater": "~2",
    "@wavesurfer/react": "^1.0.12",
    "agentation": "^3.0.2",
    "audiobuffer-to-wav": "^1.0.0",
    "fix-webm-duration": "^1.0.6",
    "leva": "^0.10.1",
    "loro-crdt": "^1.6.2",
    "master-cmdk": "link:../better-cmdk/packages/master-cmdk",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wa-sqlite": "^1.0.0",
    "wavesurfer.js": "^7.12.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/audiobuffer-to-wav": "^1.0.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.7.2",
    "vite": "^6.3.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.4"
  }
}
