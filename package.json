{
  "name": "branch-continue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @natnaelkahssay/card-stack-3d build && vite",
    "build": "pnpm --filter @natnaelkahssay/card-stack-3d build && tsc -b && vite build",
    "deploy": "pnpm app:deploy",
    "app:package": "pnpm tauri:build",
    "app:deploy": "pnpm app:package && ./scripts/deploy-single-app.sh",
    "mobile:ota:bundle": "node scripts/mobile-ota.mjs bundle",
    "mobile:shell:android": "node scripts/mobile-ota.mjs shell android",
    "mobile:shell:android:apk": "node scripts/mobile-ota.mjs shell android --apk",
    "mobile:shell:ios": "node scripts/mobile-ota.mjs shell ios",
    "test": "pnpm --filter @natnaelkahssay/card-stack-3d build && vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build"
  },
  "dependencies": {
    "@natnaelkahssay/card-stack-3d": "workspace:*",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "master-cmdk": "link:../better-cmdk/packages/master-cmdk",
    "leva": "^0.10.1",
    "loro-crdt": "^1.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wa-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.7.2",
    "vite": "^6.3.2",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.4"
  }
}
